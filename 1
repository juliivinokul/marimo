import numpy as np
from statsmodels.sandbox.stats.runs import runstest_2samp

# Данные
physics = np.array([
    79, 90, 63, 78, 61, 59, 68, 75, 81, 58, 85, 79, 51, 36, 65, 44, 41,
    67, 68, 80, 64, 85, 54, 70, 66, 71, 81, 73, 72, 85, 89, 77, 96, 80,
    59, 84, 77, 53, 89, 68, 59, 73, 90, 90, 74, 82, 79, 66, 61, 83, 91, 77
])
literature = np.array([
    75, 54, 88, 68, 56, 74, 80, 57, 82, 69, 75, 75, 62, 58, 82, 77, 72,
    82, 64, 53
])

# Выполнение теста Вальда–Волфовица (на чередования)
z_stat, p_value = runstest_2samp(physics, literature)

print(f"Z-статистика: {z_stat:.4f}")
print(f"p-value: {p_value:.4f}")

if p_value < 0.05:
    print("→ Различие статистически значимо (p < 0.05)")
else:
    print("→ Различие не является статистически значимым (p ≥ 0.05)")
